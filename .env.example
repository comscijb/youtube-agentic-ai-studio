# YouTube AI Agent Studio — Environment Variables
# Copy this file to .env and fill in your keys.
# The app reads these automatically (config.py uses os.getenv).

GEMINI_API_KEY=your_gemini_api_key_here
GEMINI_MODEL=gemini-3.6-flash
# Long-form request deadline in seconds (outline, scenes, editorial review)
GEMINI_TIMEOUT_SECONDS=300
# Thinking depth: minimal | low | medium | high, an integer budget, or empty for the model default
GEMINI_THINKING_LEVEL=
# Largest single repair prompt; bigger outline repairs become scene-scoped
GEMINI_REPAIR_MAX_CHARS=120000
# Overload/rate-limit backoff on the same model before fallback, and the per-call wall clock
GEMINI_OVERLOAD_RETRIES=4
GEMINI_OVERLOAD_BASE_DELAY=10
GEMINI_OVERLOAD_MAX_DELAY=90
GEMINI_MAX_CALL_WALLCLOCK=600
# One bounded rewrite of scenes cited by major editorial findings (+1 revision, +1 re-review worst case)
NARRATIVE_SEMANTIC_REVISION_ENABLED=true
# Minutes between background YouTube publication-state syncs while the GUI runs
PUBLICATION_SYNC_INTERVAL_MINUTES=30
PIXABAY_API_KEY=your_pixabay_api_key_here

# Published projects are archived from the SSD to this folder (HDD); queued if the drive is missing
ARCHIVE_ROOT=D:\Private Gravity\Archive
ARCHIVE_ON_PUBLISH=true

# Target share of wide/establishing shots (guidance and a warning, never a failure)
IMAGEGEN_MIN_WIDE_SHARE=0.3
# Visual QA of every generated shot with Gemini vision (headcount, duplicates, glasses, injuries, text)
IMAGEGEN_VISUAL_QA=true
IMAGEGEN_QA_RETRIES=2

# Stock images (Pixabay/Openverse) are off by default: shots are generated by ComfyUI.
# true = use stock in cinematic_photo mode, or as a last resort for environment/object shots.
STOCK_ENABLED=false
# Stock provider when enabled: auto | pixabay | openverse
STOCK_PROVIDER=auto
STOCK_FALLBACK_PROVIDER=openverse
STOCK_CACHE_ENABLED=true
STOCK_LICENSE_LOG_ENABLED=true
STOCK_LOCAL_ASSET_DIR=assets/stock_approved

# Optional — only needed if using ElevenLabs TTS instead of Edge TTS
ELEVENLABS_API_KEY=your_elevenlabs_key_here
