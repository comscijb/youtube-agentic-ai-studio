# YouTube AI Agent Studio — Environment Variables
# Copy this file to .env and fill in your keys.
# The app reads these automatically (config.py uses os.getenv).

GEMINI_API_KEY=your_gemini_api_key_here
PIXABAY_API_KEY=your_pixabay_api_key_here

# Stock images: auto | pixabay | openverse
STOCK_PROVIDER=auto
STOCK_FALLBACK_PROVIDER=openverse
STOCK_CACHE_ENABLED=true
STOCK_LICENSE_LOG_ENABLED=true
STOCK_LOCAL_ASSET_DIR=assets/stock_approved

# Optional — only needed if using ElevenLabs TTS instead of Edge TTS
ELEVENLABS_API_KEY=your_elevenlabs_key_here
